{
    "importMap": "import_map.json",
    "tasks": {
        "build": "deno run --location=http://localhost --allow-read --allow-write --allow-net --allow-env --allow-run tasks/build.ts",
        "serve": "deno run --allow-read --allow-net tasks/serve.ts",
        "verify": "deno run --allow-read --allow-run --allow-env tasks/verify.ts"
    },
    "compilerOptions": {
        "lib": ["dom", "esnext", "deno.ns"]
    },
    "lint": {
        "rules": {
            "include": ["recommended"],
            "exclude": ["ban-ts-comment"] // allow @ts-ignore for edge cases like render()
        }
    },
    "fmt": {
        "include": [""],
        "useTabs": false,
        "lineWidth": 80,
        "indentWidth": 4,
        "semiColons": true,
        "singleQuote": false
    }
}
